generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

/* datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} */

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Advisor {
  id         String      @id @default(cuid())
  name       String
  email      String     @unique
  households Household[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Household {
  id         String      @id @default(cuid())
  name       String
  advisorId  String
  advisor    Advisor     @relation(fields: [advisorId], references: [id])
  members    Client[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([advisorId])
}

model Client {
  id            String                @id @default(cuid())
  firstName     String
  lastName      String
  email         String               @unique
  phone         String
  relationType  RelationType

  householdId   String
  household     Household            @relation(fields: [householdId], references: [id])

  accounts    Account[]
  portfolios  Portfolio[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([householdId])
}

enum RelationType {
  SPOUSE
  CHILD
  PARENT
}

model Account {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])

  number      String
  type        AccountType
  aum         Float

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clientId])
}

enum AccountType {
  BROKERAGE
  RETIREMENT
  CASH
}

model Portfolio {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  positions   Position[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clientId])
}

model Position {
  id          String     @id @default(cuid())
  portfolioId String
  portfolio   Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  securityId  String
  quantity    Float
  marketValue Float

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([portfolioId])
  @@index([securityId])
}